---
/*
 * Starlight's footer (edit link, last updated, pagination), then the family
 * footer: maintained by Pulzar, the license, and the repository.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import site from 'virtual:pulzar-docs/site';
import wordmark from '../../assets/wordmark.png';
---

<Default />
<div class="pz-footer">
	<a class="maintained" href="https://pulzr.net" aria-label="Maintained by Pulzar">
		<span>Maintained by</span>
		<span class="wordmark" style={`--pz-wordmark: url(${wordmark.src})`} aria-hidden="true"></span>
	</a>
	<p class="meta">
		<a href={`${site.repo}/blob/main/LICENSE`}>{site.license} license</a>
		<span aria-hidden="true">·</span>
		<a href={site.repo}>Source on GitHub</a>
		<span aria-hidden="true">·</span>
		<a href={`${site.repo}/security/advisories/new`}>Report a vulnerability</a>
	</p>
</div>

<style>
	.pz-footer {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.maintained {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		color: inherit;
		text-decoration: none;
	}
	.wordmark {
		display: inline-block;
		height: 0.95em;
		aspect-ratio: 429 / 96;
		background: var(--sl-color-white);
		mask: var(--pz-wordmark) center / contain no-repeat;
		-webkit-mask: var(--pz-wordmark) center / contain no-repeat;
	}
	.maintained:hover .wordmark {
		background: var(--sl-color-accent);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
	}
	.meta a {
		color: inherit;
	}
	.meta a:hover {
		color: var(--sl-color-white);
	}
</style>
