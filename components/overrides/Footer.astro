---
/*
 * Starlight's footer (edit link, last updated, pagination), then one line
 * for the family: who maintains it, the license, the source, how to report
 * a vulnerability, the trademarks and attributions page, and what builds it.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import site from 'virtual:pulzar-docs/site';
import wordmark from '../../assets/wordmark.svg?url';
import Mark from '../Mark.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default />
<footer class="pz-footer">
	<a class="maintained" href="https://pulzr.net">
		<span>Maintained by</span>
		<span class="wordmark" style={`--pz-wordmark: url(${JSON.stringify(wordmark)})`} role="img" aria-label="Pulzr"></span>
	</a>
	<ul class="links">
		<li><a href={`${site.repo}/blob/main/LICENSE`}>{site.license} license</a></li>
		<li><a href={site.repo}>Source</a></li>
		<li><a href={`${site.repo}/security/advisories/new`}>Report a vulnerability</a></li>
		<li><a href={`${base}/attributions.html`}>Trademarks and attributions</a></li>
	</ul>
	<a class="built" href="https://starlight.astro.build/">
		<span>Built with</span>
		<Mark id="starlight" name={false} />
	</a>
</footer>

<style>
	.pz-footer {
		margin-top: 2rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--sl-color-hairline);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem 1.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	.maintained,
	.built {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
	}
	.wordmark {
		display: inline-block;
		height: 0.95em;
		aspect-ratio: 344 / 95;
		background: var(--sl-color-white);
		mask: var(--pz-wordmark) center / contain no-repeat;
		-webkit-mask: var(--pz-wordmark) center / contain no-repeat;
	}
	/* Astro's press guidelines: the logo at least 24px high. */
	.built :global(.pz-mark img) {
		height: 24px;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links li {
		margin: 0;
	}
</style>
