---
/*
 * How to download a release binary and check it against SHA256SUMS. The
 * commands are generated from the release's file names, so they match what
 * the release workflow publishes.
 *
 *   <ReleaseDownload repo="pulzar-net/zwave-bridge" version="0.2.0"
 *     binary="zwave-bridge" asset="{binary}-{arch}-linux-musl" />
 *
 * `asset` may use {binary}, {version} and {arch}; `arch` is filled from
 * `uname -m` (x86_64 or aarch64).
 */
import { Code } from '@astrojs/starlight/components';
interface Props {
	repo: string;
	version: string;
	binary: string;
	asset?: string;
	installTo?: string;
	archs?: { arch: string; label: string }[];
}
const {
	repo,
	version,
	binary,
	asset = '{binary}-{arch}-linux-musl',
	installTo = '/usr/local/bin',
	archs = [
		{ arch: 'x86_64', label: 'PCs and servers' },
		{ arch: 'aarch64', label: 'Raspberry Pi 3 and newer, 64-bit OS' },
		{ arch: 'mipsel', label: 'MT7621 and MT7628 routers' },
	],
} = Astro.props;
const file = asset.replaceAll('{binary}', binary).replaceAll('{version}', '$VERSION').replaceAll('{arch}', '$ARCH');
const code = [
	`VERSION=${version}`,
	`ARCH=$(uname -m)   # x86_64 or aarch64`,
	`BASE=https://github.com/${repo}/releases/download/v$VERSION`,
	`curl -fsSLO "$BASE/${file}"`,
	`curl -fsSLO "$BASE/SHA256SUMS"`,
	`sha256sum --check --ignore-missing SHA256SUMS`,
	`sudo install -m 0755 "${file}" ${installTo}/${binary}`,
	`${binary} --version`,
].join('\n');
const releaseUrl = `https://github.com/${repo}/releases/tag/v${version}`;
---

<div class="pz-release not-content">
	<div class="head">
		<span class="label">Release</span>
		<a class="version" href={releaseUrl}>v{version}</a>
		<span class="archs">{archs.map((a) => <span title={a.label}>{a.arch}</span>)}</span>
	</div>
	<Code code={code} lang="sh" />
	<p class="check">
		<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
		<code>sha256sum --check</code> must print <code>OK</code> for the file you downloaded before you install it.
	</p>
</div>

<style>
	.pz-release {
		margin: 1.25rem 0;
		padding: 0.75rem;
		background: var(--pz-surface);
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--pz-radius-md);
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin-bottom: 0.6rem;
	}
	.label {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.version {
		font-family: var(--sl-font-mono);
		font-weight: 500;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-accent);
		text-decoration: none;
	}
	.version:hover {
		text-decoration: underline;
	}
	.archs {
		display: flex;
		gap: 0.35rem;
		margin-inline-start: auto;
	}
	.archs span {
		padding: 0.05rem 0.45rem;
		border-radius: var(--pz-radius-sm);
		font-size: var(--sl-text-xs);
		font-family: var(--sl-font-mono);
		color: var(--pz-text-secondary);
		border: 1px solid var(--sl-color-hairline-light);
	}
	.check {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.7rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--pz-text-secondary);
	}
	.check svg {
		color: var(--pz-status-tested);
		flex-shrink: 0;
	}
	.check code {
		font-size: 0.95em;
		padding: 0.05em 0.3em;
		border-radius: var(--pz-radius-sm);
		background: var(--sl-color-bg-inline-code);
		font-family: var(--sl-font-mono);
	}
</style>
