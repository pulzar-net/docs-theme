---
/*
 * A project's landing header: its name (set as the identifier it is), one
 * line on what it does, what it is built on, and a row of plain actions. Use on
 * a page with `template: splash`. The stack line comes from projects.mjs.
 */
import site from 'virtual:pulzar-docs/site';
import Mark from './Mark.astro';

interface Action {
	text: string;
	link: string;
	variant?: 'primary' | 'secondary' | 'minimal';
}
interface Props {
	title: string;
	tagline: string;
	actions?: Action[];
}
const { title, tagline, actions = [] } = Astro.props;
const stack: string[] = site.self?.stack ?? [];
const isGitHub = (a: Action) => a.link.startsWith('https://github.com/');
---

<section class="pz-hero not-content">
	<h1>{title}</h1>
	<p class="tagline">{tagline}</p>
	{stack.length > 0 && (
		<ul class="stack" aria-label="Built with">
			{stack.map((id) => <li><Mark id={id} /></li>)}
		</ul>
	)}
	<slot />
	{actions.length > 0 && (
		<div class="actions">
			{actions.map((a, i) => (
				<a href={a.link} class:list={['action', a.variant ?? (i === 0 ? 'primary' : 'minimal')]}>
					{isGitHub(a) && <Mark id="github" name={false} decorative />}
					<span>{a.text}</span>
				</a>
			))}
		</div>
	)}
</section>

<style>
	.pz-hero {
		padding: 1.25rem 0 0.5rem;
	}
	h1 {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: clamp(1.625rem, 3vw, 2.125rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}
	.tagline {
		margin: 0.5rem 0 0;
		max-width: var(--pz-prose-width);
		font-size: 1rem;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}
	.stack li {
		margin: 0;
		padding: 0.15rem 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--pz-radius-sm);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.8rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		line-height: 1.3;
		text-decoration: none;
		border-radius: var(--pz-radius-md);
		border: 1px solid var(--sl-color-hairline-light);
		color: var(--sl-color-white);
	}
	.action:hover {
		border-color: var(--sl-color-gray-4);
		background: var(--pz-surface);
	}
	.action.primary {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.action.primary:hover {
		background: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent-high);
	}
	:global([data-theme='light']) .action.primary {
		color: #fff;
	}
	:global([data-theme='light']) .action.primary:hover {
		background: var(--sl-color-accent-high);
	}
	.action:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
</style>
