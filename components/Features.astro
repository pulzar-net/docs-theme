---
/*
 * What a project does, as a list: each entry's title, then a line or two.
 * `items` is a list of { title, body, link?, mark? }: `mark` names a real
 * thing (marks.mjs) and shows its logo where the owner allows it. No stock
 * icons: an entry is its title and one or two lines.
 */
import Mark from './Mark.astro';

interface Item {
	title: string;
	body: string;
	mark?: string;
	link?: string;
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---

<div class="pz-features not-content">
	{items.map((item) => {
		const Tag = item.link ? 'a' : 'div';
		return (
			<Tag class="item" href={item.link}>
				<h3>
					{item.mark && <Mark id={item.mark} name={false} decorative />}
					<span>{item.title}</span>
				</h3>
				<p>{item.body}</p>
			</Tag>
		);
	})}
</div>

<style>
	/* A list, one entry per row: the title, then what it means. Scans like a
	   reference table at any width, with no orphaned cells. */
	.pz-features {
		margin: 1.25rem 0;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.item {
		display: grid;
		grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
		gap: 0.25rem 1.5rem;
		align-items: baseline;
		padding: 0.6rem 0.25rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		text-decoration: none;
		color: inherit;
	}
	a.item:hover {
		background: var(--pz-surface);
	}
	a.item:hover h3 span:last-child {
		color: var(--sl-color-accent);
	}
	a.item:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	h3 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.45;
		color: var(--sl-color-white);
	}
	p {
		margin: 0;
		max-width: var(--pz-prose-width);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--pz-text-secondary);
	}
	@media (max-width: 40rem) {
		.item {
			grid-template-columns: 1fr;
		}
	}
</style>
