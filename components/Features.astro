---
/*
 * What a project does, as a compact grid of short entries sharing hairlines.
 * `items` is a list of { title, body, link?, icon?, mark? }: `icon` is a
 * generic Starlight icon; `mark` names a real thing (marks.mjs) and shows its
 * logo where the owner allows it. Never use an icon that redraws a logo.
 */
import { Icon } from '@astrojs/starlight/components';
import Mark from './Mark.astro';

interface Item {
	title: string;
	body: string;
	icon?: string;
	mark?: string;
	link?: string;
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---

<div class="pz-features not-content">
	{items.map((item) => {
		const Tag = item.link ? 'a' : 'div';
		return (
			<Tag class="item" href={item.link}>
				<h3>
					{item.mark ? <Mark id={item.mark} name={false} decorative /> : item.icon && <span class="icon"><Icon name={item.icon as any} size="1rem" /></span>}
					<span>{item.title}</span>
				</h3>
				<p>{item.body}</p>
			</Tag>
		);
	})}
</div>

<style>
	.pz-features {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--pz-radius-md);
		overflow: hidden;
	}
	/* Each entry draws its right and bottom hairlines; the box clips the
	   ones on its outer edge, and an unfilled last row stays empty. */
	.item {
		display: block;
		padding: 0.85rem 1rem 0.95rem;
		box-shadow: 1px 0 0 var(--sl-color-hairline), 0 1px 0 var(--sl-color-hairline);
		text-decoration: none;
		color: inherit;
	}
	a.item:hover {
		background: var(--pz-surface);
	}
	a.item:hover h3 span:last-child {
		color: var(--sl-color-accent);
	}
	a.item:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	h3 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.35;
		color: var(--sl-color-white);
	}
	.icon {
		display: inline-flex;
		color: var(--sl-color-accent);
	}
	p {
		margin: 0.3rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--pz-text-secondary);
	}
</style>
