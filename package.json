{
  "name": "@pulzr/docs-theme",
  "version": "0.6.0",
  "description": "The shared Starlight theme, components and starter for Pulzar's open-source project docs.",
  "license": "MIT",
  "author": "Pulzar LLC",
  "homepage": "https://oss.pulzr.net/docs-theme/",
  "bugs": "https://github.com/pulzar-net/docs-theme/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulzar-net/docs-theme.git"
  },
  "keywords": [
    "starlight",
    "astro",
    "starlight-theme",
    "withastro",
    "documentation",
    "pulzr"
  ],
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./projects": "./projects.mjs",
    "./components": "./components/index.mjs",
    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "pulzr-docs": "./bin/pulzr-docs.mjs"
  },
  "files": [
    "assets",
    "bin",
    "components",
    "index.mjs",
    "marks.mjs",
    "pages",
    "projects.mjs",
    "starter",
    "status-badges.mjs",
    "status.mjs",
    "styles"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.43.0",
    "astro": ">=7.4.0",
    "@scalar/api-reference": "1.82.1"
  },
  "peerDependenciesMeta": {
    "@scalar/api-reference": {
      "optional": true
    }
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.43.1",
    "@scalar/api-reference": "1.82.1",
    "astro": "7.4.13"
  },
  "scripts": {
    "dev": "astro dev --root demo",
    "build": "astro build --root demo",
    "preview": "astro preview --root demo"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
