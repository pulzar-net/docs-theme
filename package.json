{
  "name": "@pulzar-net/docs-theme",
  "version": "0.1.2",
  "description": "The shared Starlight theme, components and starter for Pulzar's open-source project docs.",
  "license": "MIT",
  "author": "Pulzar LLC",
  "repository": "github:pulzar-net/docs-theme",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./components": "./components/index.mjs",
    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./assets/*": "./assets/*"
  },
  "bin": {
    "pulzar-docs": "./bin/pulzar-docs.mjs"
  },
  "files": [
    "index.mjs",
    "projects.mjs",
    "components",
    "styles",
    "assets",
    "bin",
    "starter"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.43.0",
    "astro": ">=7.4.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13"
  },
  "scripts": {
    "dev": "astro dev --root demo",
    "build": "astro build --root demo",
    "preview": "astro preview --root demo"
  }
}
